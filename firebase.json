{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "QUẢN TRỊ MARKETING AI AGENT - ANCV",
        "supportEmail": "nhat.ngtan@gmail.com",
        "authorizedRedirectUris": ["https://ancv-marketing-ai-agent.web.app/__/auth/handler"]
      }
    }
  },
  "firestore": { "rules": "firebase/firestore.rules", "indexes": "firebase/firestore.indexes.json" },
  "storage": { "rules": "firebase/storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8085 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
