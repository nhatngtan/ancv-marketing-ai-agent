rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function editor() { return signedIn() && userDoc().data.status == 'active' && userDoc().data.role in ['admin', 'editor']; }
    match /content/{contentId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if editor() && request.resource.size < 500 * 1024 * 1024;
      allow delete: if signedIn() && userDoc().data.role == 'admin';
    }
    match /flow-errors/{jobId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

