{
  "name": "@ancv/flow-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run --exclude dist/**",
    "login": "tsx src/index.ts login",
    "preflight": "tsx src/index.ts preflight",
    "start": "tsx src/index.ts worker",
    "local-agent": "tsx src/index.ts local-agent",
    "local-preflight": "tsx src/index.ts local-preflight",
    "local-configure": "tsx src/index.ts local-configure"
  },
  "dependencies": {
    "@ancv/shared": "workspace:*",
    "firebase-admin": "^13.5.0",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
