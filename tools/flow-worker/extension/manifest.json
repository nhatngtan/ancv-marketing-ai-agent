{
  "manifest_version": 3,
  "name": "ANCV Browser Bridge",
  "version": "0.1.0",
  "description": "Cầu nối cục bộ, giới hạn cho Google Flow và ANCV Local Agent.",
  "permissions": ["tabs", "scripting", "downloads", "storage"],
  "host_permissions": ["https://labs.google/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["setup.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "ANCV Browser Bridge" }
}
